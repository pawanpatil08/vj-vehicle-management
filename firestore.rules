rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Rules in this block only apply to documents in /users/{userId}.
    // Other collections and document paths are controlled by separate rules
    // declared elsewhere in this file.
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow write: if request.auth != null && (
        request.auth.uid == userId
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Add rules for other collections below, for example:
    // match /vehicles/{vehicleId} { ... }
  }
}
